# Telegram bot token from @BotFather
BOT_TOKEN=

# Solana RPC — Helius free tier recommended (https://helius.dev)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Optional: cache TTL for scans, seconds
SCAN_CACHE_TTL=120

# Supabase (optional — without these, scans are only counted in memory)
SUPABASE_URL=
SUPABASE_ANON_KEY=
